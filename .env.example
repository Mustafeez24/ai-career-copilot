# Next.js frontend: proxy requests to the Spring Boot backend
SPRING_BOOT_API_URL=http://localhost:8080

# External API keys (used by the Spring Boot backend)
SERPAPI_KEY=your_serpapi_key
NVIDIA_API_KEY=your_nvidia_api_key

# Use a unique Base64-encoded secret outside local development
# Generate with: openssl rand -base64 32
JWT_SECRET=YWktY2FyZWVyLWNvcGlsb3QtZGV2ZWxvcG1lbnQtc2VjcmV0LWtleS0zMi1ieXRlcyE=

# Database settings (Docker Compose defaults are for local development only)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-this-local-password
