# Frontend (Next.js) can proxy its API requests to the Spring Boot backend.
SPRING_BOOT_API_URL=http://localhost:8080

# External integrations used by the Spring Boot backend
SERPAPI_KEY=your_serpapi_key
NVIDIA_API_KEY=your_nvidia_api_key

# Use a unique Base64-encoded secret (at least 32 bytes) outside local development.
JWT_SECRET=replace_with_a_long_base64_secret